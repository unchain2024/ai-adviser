# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
CLAUDE.md

# Figma exports — design source of truth lives in Figma, not in the app bundle.
# Kept locally for re-slicing artwork; never served, never committed.
/design-source

# npm lockfile — this project uses pnpm; pnpm-lock.yaml is the source of truth
package-lock.json
